# Sentinel Phase 1 Configuration

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server
HOST=0.0.0.0
PORT=8000

# Google Gemini API (official google-genai SDK)
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama Fallback (Local model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=30.0

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sentinel_docs
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Redis Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# RAG & Context Grading
RETRIEVAL_TOP_K=4
SCORE_THRESHOLD=0.45

# OpenTelemetry Distributed Tracing (Phase 2)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=sentinel-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Automated Evaluations & Groundedness Gate (Phase 3)
GROUNDEDNESS_THRESHOLD=0.70
GROUNDEDNESS_GATE_ENABLED=true

# Safety Guardrails, Semantic Cache & Cost Routing (Phase 4)
GUARDRAILS_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.90
SEMANTIC_CACHE_COLLECTION=sentinel_semantic_cache
COST_ROUTING_ENABLED=true

